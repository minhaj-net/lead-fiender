{
  "manifest_version": 3,
  "name": "Codeloom Lead Finder",
  "version": "1.0.0",
  "description": "Local lead-research automation tool for Codeloom. Connects to a local FastAPI backend.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Codeloom Lead Finder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
