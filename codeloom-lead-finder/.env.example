# ──────────────────────────────────────────────
# Codeloom Lead Finder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=codeloom_leads

# FastAPI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CSV Export directory (relative to project root)
CSV_EXPORT_DIR=data

# Automation settings
AUTOMATION_HEADLESS=false
AUTOMATION_SLOW_MO=50
